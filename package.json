{
  "name": "pomolice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ipc:generate": "node scripts/ipc-bindings.mjs && oxlint src/ipc/generated.ts",
    "ipc:check": "node scripts/ipc-bindings.mjs --check",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "verify": "npm run format:check && npm run format:rust:check && npm run lint && npm run build && npm run ipc:check && npm run lint:rust && npm run test && npm run test:rust",
    "build:linux": "docker build --platform linux/amd64 --file docker/ubuntu22.Dockerfile --output type=local,dest=artifacts/ubuntu22 .",
    "test:linux:portal": "docker build --platform linux/amd64 --file docker/portal-registration.Dockerfile --tag pomolice-portal-registration:local .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "audit:rust": "cargo audit",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "prepare": "husky",
    "test": "vitest --no-watch",
    "test:e2e": "npm run test:e2e:build && npm run test:e2e:run",
    "test:e2e:build": "tsx e2e/build.ts",
    "test:e2e:run": "wdio run e2e/wdio.conf.ts",
    "test:logging": "npm run test:logging:frontend && npm run test:logging:rust",
    "test:logging:frontend": "vitest --no-watch src/logging/logger.test.ts src/logging/redaction.test.ts src/logging/devtools.test.ts src/app/sync/useBackendSync.test.ts src/services/notifications.preview.test.ts src/features/timer/sessionNotifications.test.ts",
    "test:logging:rust": "cargo test --manifest-path src-tauri/Cargo.toml tests::log",
    "test:rust": "cargo test --workspace --exclude pomolice && cargo test -p pomolice",
    "test:core": "cargo test -p pomolice-core",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "immer": "^11.1.21",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "@wdio/types": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
