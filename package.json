{
  "name": "pomolice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ipc:generate": "node scripts/ipc-bindings.mjs",
    "ipc:check": "node scripts/ipc-bindings.mjs --check",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "build:linux": "docker build --platform linux/amd64 --file docker/ubuntu22.Dockerfile --output type=local,dest=artifacts/ubuntu22 .",
    "test:linux:portal": "docker build --platform linux/amd64 --file docker/portal-registration.Dockerfile --tag pomolice-portal-registration:local .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:rust": "cd src-tauri && cargo audit",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "husky",
    "test": "vitest --no-watch",
    "test:logging": "npm run test:logging:frontend && npm run test:logging:rust",
    "test:logging:frontend": "vitest --no-watch src/logging/logger.test.ts src/logging/redaction.test.ts src/logging/devtools.test.ts src/app/sync/useBackendSync.test.ts src/services/notifications.preview.test.ts src/features/timer/sessionNotifications.test.ts",
    "test:logging:rust": "cargo test --manifest-path src-tauri/Cargo.toml tests::log",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "immer": "^11.1.3",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.13",
    "vitest": "^4.0.16"
  }
}
