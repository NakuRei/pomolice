{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pomolice",
  "version": "0.1.0",
  "identifier": "io.github.NakuRei.pomolice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pomolice",
        "width": 800,
        "height": 600,
        "minWidth": 380,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**"]
      },
      "csp": {
        "default-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "script-src": ["'self'"],
        "style-src": ["'self'"],
        "img-src": ["'self'", "asset:", "data:"],
        "font-src": ["'self'", "asset:", "data:"],
        "media-src": ["'self'", "asset:", "http://asset.localhost"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"]
      },
      "devCsp": {
        "default-src": [
          "'self'",
          "http://localhost:1420",
          "ipc:",
          "http://ipc.localhost"
        ],
        "script-src": ["'self'", "http://localhost:1420"],
        "style-src": ["'self'", "'unsafe-inline'", "http://localhost:1420"],
        "img-src": ["'self'", "asset:", "data:", "http://localhost:1420"],
        "font-src": ["'self'", "asset:", "data:", "http://localhost:1420"],
        "media-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "http://localhost:1420"
        ],
        "connect-src": [
          "'self'",
          "ws://localhost:1420",
          "http://localhost:1420",
          "ipc:",
          "http://ipc.localhost"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (c) 2025 NakuRei",
    "licenseFile": "../LICENSE",
    "resources": {
      "resources/sounds/*.wav": "resources/sounds",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
