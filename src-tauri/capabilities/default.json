{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "notification:default",
    "allow-is-tray-available",
    "allow-has-input-monitor-failed",
    "allow-get-emergency-shortcut-status",
    "allow-exit-without-tray",
    "allow-start-work",
    "allow-resolve-post-break-decision",
    "allow-set-away-during-break",
    "allow-emergency-stop",
    "allow-update-settings",
    "allow-get-full-state",
    "allow-resolve-boot-auto-start-prompt"
  ]
}
