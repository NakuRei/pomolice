{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "notification:default",
    "allow-start-work",
    "allow-resolve-post-break-decision",
    "allow-emergency-stop",
    "allow-sync-timer-duration-settings",
    "allow-sync-automation-policies",
    "allow-get-full-state",
    "allow-resolve-boot-auto-start-prompt"
  ]
}
